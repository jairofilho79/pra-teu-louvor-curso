---
// src/components/VideoLesson.astro
interface Props {
  videoId: string;
  modulo: number;
  aulaNum: number;
  title: string;
  timestamps?: Array<{ segundos: number; rotulo: string; link?: string }>;
}

const { videoId, modulo, aulaNum, title, timestamps = [] } = Astro.props;
---

<div class="video-lesson-component" data-video-id={videoId} data-modulo={modulo} data-aula={aulaNum}>
  <!-- Video Frame -->
  <div class="video-wrapper">
    <iframe
      id="lessonVideoIframe"
      src={`https://www.youtube-nocookie.com/embed/${videoId}?enablejsapi=1&rel=0`}
      title={title}
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>

  <!-- Lesson Action Bar -->
  <div class="lesson-action-bar">
    <div class="bar-left">
      <label class="toggle-completed-label" title="Marcar aula como concluída no seu progresso">
        <input type="checkbox" id="toggleCompletedInput" />
        <span class="custom-checkbox"></span>
        <span class="toggle-text" id="toggleCompletedText">Concluir Aula</span>
      </label>

      <button type="button" class="btn-favorite-lesson" id="toggleFavoriteBtn" title="Adicionar aos favoritos">
        <span class="fav-icon">⭐</span>
        <span class="fav-text" id="favText">Favoritar</span>
      </button>
    </div>

    <div class="bar-right">
      <button type="button" class="btn-copy-lesson" id="btnCopyLessonLink" title="Copiar link desta aula">
        🔗 Compartilhar Aula
      </button>
    </div>
  </div>
</div>

<script>
  function setupLessonActions() {
    const root = document.querySelector('.video-lesson-component');
    if (!root) return;

    const videoId = root.getAttribute('data-video-id');
    if (!videoId) return;

    const iframe = document.getElementById('lessonVideoIframe') as HTMLIFrameElement;
    const chk = document.getElementById('toggleCompletedInput') as HTMLInputElement;
    const chkText = document.getElementById('toggleCompletedText');
    const favBtn = document.getElementById('toggleFavoriteBtn');
    const favText = document.getElementById('favText');
    const copyBtn = document.getElementById('btnCopyLessonLink');

    // Carrega dados salvos
    const completedList = JSON.parse(localStorage.getItem('ptl_completed') || '[]');
    const favoritesList = JSON.parse(localStorage.getItem('ptl_favorites') || '[]');

    const isCompleted = completedList.includes(videoId);
    const isFavorite = favoritesList.includes(videoId);

    if (chk) {
      chk.checked = isCompleted;
      if (chkText) chkText.innerText = isCompleted ? 'Aula Concluída ✅' : 'Concluir Aula';
      
      chk.addEventListener('change', () => {
        let current = JSON.parse(localStorage.getItem('ptl_completed') || '[]');
        if (chk.checked) {
          if (!current.includes(videoId)) current.push(videoId);
          if (chkText) chkText.innerText = 'Aula Concluída ✅';
        } else {
          current = current.filter((id: string) => id !== videoId);
          if (chkText) chkText.innerText = 'Concluir Aula';
        }
        localStorage.setItem('ptl_completed', JSON.stringify(current));
        window.dispatchEvent(new CustomEvent('ptl:progress-updated'));
      });
    }

    if (favBtn) {
      if (isFavorite) {
        favBtn.classList.add('is-fav');
        if (favText) favText.innerText = 'Favoritada ⭐';
      }

      favBtn.addEventListener('click', () => {
        let currentFavs = JSON.parse(localStorage.getItem('ptl_favorites') || '[]');
        const has = currentFavs.includes(videoId);
        if (has) {
          currentFavs = currentFavs.filter((id: string) => id !== videoId);
          favBtn.classList.remove('is-fav');
          if (favText) favText.innerText = 'Favoritar';
        } else {
          currentFavs.push(videoId);
          favBtn.classList.add('is-fav');
          if (favText) favText.innerText = 'Favoritada ⭐';
        }
        localStorage.setItem('ptl_favorites', JSON.stringify(currentFavs));
        window.dispatchEvent(new CustomEvent('ptl:progress-updated'));
      });
    }

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const cleanUrl = window.location.origin + window.location.pathname;
        try {
          await navigator.clipboard.writeText(cleanUrl);
          const original = copyBtn.innerText;
          copyBtn.innerText = '✅ Link Copiado!';
          setTimeout(() => { copyBtn.innerText = original; }, 2500);
        } catch {
          alert('Link da aula: ' + cleanUrl);
        }
      });
    }

    // Intercepta cliques nos botões de timestamps gerados no markdown
    document.querySelectorAll('.btn-jump').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        const target = e.currentTarget as HTMLElement;
        const timeSec = target.getAttribute('data-time');
        if (timeSec && iframe) {
          iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1&start=${timeSec}&enablejsapi=1`;
          iframe.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  }

  // Executa no load e após trocas de rota do Astro/Starlight
  setupLessonActions();
  document.addEventListener('astro:page-load', setupLessonActions);
</script>

<style>
  .video-lesson-component {
    margin: 1.5rem 0 2rem 0;
    border-radius: 14px;
    overflow: hidden;
    background: var(--sl-color-bg-sidebar, #0f172a);
    border: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.12));
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 ratio */
    height: 0;
    overflow: hidden;
    background: #000000;
  }

  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .lesson-action-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding: 0.85rem 1.25rem;
    background: var(--sl-color-bg-sidebar, #1e293b);
    border-top: 1px solid var(--sl-color-hairline, rgba(255, 255, 255, 0.08));
  }

  .bar-left, .bar-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Custom Checkbox Toggle */
  .toggle-completed-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    font-size: 0.9rem;
    font-weight: 600;
    user-select: none;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-hairline);
    transition: background 0.2s;
  }
  .toggle-completed-label:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .toggle-completed-label input[type="checkbox"] {
    accent-color: #10b981;
    width: 18px;
    height: 18px;
    cursor: pointer;
  }

  /* Favorite Button */
  .btn-favorite-lesson {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-white);
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-favorite-lesson:hover {
    background: rgba(255, 255, 255, 0.1);
  }
  .btn-favorite-lesson.is-fav {
    background: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.5);
    color: #f59e0b;
  }

  /* Copy Lesson Link */
  .btn-copy-lesson {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.75rem;
    border-radius: 8px;
    background: transparent;
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-copy-lesson:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-text-accent);
  }

  /* Interactive Timestamps jump button inside Markdown table */
  :global(.btn-jump) {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.4);
    color: var(--sl-color-text-accent, #60a5fa);
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }
  :global(.btn-jump:hover) {
    background: var(--sl-color-text-accent, #3b82f6);
    color: #ffffff;
  }

  /* Figure Styling */
  :global(.apostila-figura) {
    margin: 1.5rem 0;
    padding: 1rem;
    background: var(--sl-color-bg-sidebar);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    text-align: center;
  }
  :global(.apostila-figura img) {
    max-width: 100%;
    max-height: 520px;
    object-fit: contain;
    border-radius: 8px;
    margin: 0 auto;
    display: block;
  }
  :global(.apostila-figura figcaption) {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    font-style: italic;
  }
</style>
